# ============================================================
# CampusPool Backend – Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuspool
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- JSON Web Token ---
# Use a long, random, hard-to-guess string in production
JWT_SECRET=change_this_to_a_very_long_random_secret

# --- Express Server ---
PORT=5000
